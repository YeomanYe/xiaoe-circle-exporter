{
  "manifest_version": 3,
  "name": "小鹅通助手",
  "version": "0.1.0",
  "description": "把鹅圈子帖子的正文、附件、评论和评论媒体完整打包为 ZIP。",
  "icons": {
    "16": "icons/icon-enabled-16.png",
    "32": "icons/icon-enabled-32.png",
    "48": "icons/icon-enabled-48.png",
    "128": "icons/icon-enabled-128.png"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "offscreen",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://quanzi.xiaoe-tech.com/*",
    "https://*.xiaoe-tech.com/*",
    "https://*.xiaoeknow.com/*",
    "https://*.myqcloud.com/*",
    "http://*.myqcloud.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-disabled-16.png",
      "32": "icons/icon-disabled-32.png",
      "48": "icons/icon-disabled-48.png",
      "128": "icons/icon-disabled-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "打包鹅圈子帖子"
  },
  "content_scripts": [
    {
      "matches": ["https://quanzi.xiaoe-tech.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
